# Turso (libSQL) database. Create one with:  turso db create travelbeast
#   turso db show travelbeast --url      -> TURSO_DATABASE_URL
#   turso db tokens create travelbeast   -> TURSO_AUTH_TOKEN
TURSO_DATABASE_URL="libsql://YOUR-DB-YOUR-ORG.turso.io"
TURSO_AUTH_TOKEN=""

# Local development without Turso: leave TURSO_DATABASE_URL empty and the app uses this SQLite file.
# (Also read by the Prisma CLI for `prisma generate`.)
DATABASE_URL="file:./dev.db"

# 32+ random chars used to sign admin session cookies:  openssl rand -base64 48
AUTH_SECRET=""

# Public site URL
SITE_URL="http://localhost:3000"

# Initial admin account created by `npm run db:seed` (change the password!)
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD=""

# Cloudinary image storage (recommended / required in production).
# If left empty, uploads fall back to local disk (public/uploads) for development only.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
